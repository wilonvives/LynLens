{
  "$schema": "lynpack@1.0.0",
  "id": "energetic",
  "name": "高能",
  "description": "钩子段密集花字 · 红金橙轮换 · 关键词字号 +30% · 适合爆点 / 控诉 / 警示类内容",
  "version": "1.0.0",
  "author": {
    "name": "lynlens",
    "url": "https://lynlens.app"
  },
  "tags": ["短视频", "钩子", "爆点", "情绪反转", "高能"],

  "preview": {
    "thumbnail": "preview/thumbnail.png"
  },

  "subtitle": {
    "defaults": {
      "font": "PingFang SC Heavy",
      "fontFallback": ["阿里巴巴普惠体 Heavy", "得意黑", "Source Han Sans CN Heavy", "sans-serif"],
      "size": 64,
      "color": "#ffffff",
      "outline": { "color": "#000000", "width": 4 },
      "position": "bottom"
    },
    "keywords": {
      "palette": ["#ff3333", "#ffd700", "#ff6b00"],
      "sizeBoost": 1.3,
      "perSegment": { "min": 2, "max": 3 },
      "categoriesByPriority": [
        "情绪强词 (噩梦, 可怕, 崩溃, 爽, 神, 炸裂, 震惊)",
        "动词高潮 (爆, 崩, 炸, 杀, 抢, 拽, 砸)",
        "数字 (3 个, 10 万, 第一)",
        "品牌 / 人名 / 专有名词 (SLAPP, 苹果, 雷军)"
      ]
    }
  },

  "instructions": "prompt.md"
}
