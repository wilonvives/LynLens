{
  "$schema": "lynpack@1.0.0",
  "id": "energetic",
  "name": "高能",
  "description": "钩子段密集花字 · 红黄轮换 · 字号 +30% · 适合爆点 / 短视频 / 情绪反转",
  "version": "1.0.0",
  "author": {
    "name": "lynlens",
    "url": "https://lynlens.app"
  },
  "tags": ["短视频", "钩子", "爆点", "情绪反转", "高能"],

  "preview": {
    "thumbnail": "preview/thumbnail.png",
    "exampleFrames": [
      "preview/frames/hook.jpg",
      "preview/frames/punchline.jpg"
    ]
  },

  "subtitle": {
    "defaults": {
      "font": "PingFang SC Heavy",
      "size": 64,
      "color": "#ffffff",
      "outline": { "color": "#000000", "width": 4 },
      "position": "bottom"
    },
    "keywords": {
      "palette": ["#ff3333", "#ffd700", "#ff6b00"],
      "sizeBoost": 1.3,
      "perSegment": { "min": 2, "max": 3 },
      "categoriesByPriority": [
        "数字 (3 个, 10 万, 第一)",
        "情绪强词 (噩梦, 可怕, 崩溃, 爽, 神, 炸)",
        "动词高潮 (爆, 崩, 炸, 杀, 抢, 拽)",
        "品牌 / 人名 / 专有名词 (SLAPP, 苹果, 雷军)"
      ]
    }
  },

  "audio": {
    "sfx": [
      {
        "id": "punch",
        "file": "sfx/punch.mp3",
        "trigger": "on-punchline-segment",
        "volume": 0.4
      },
      {
        "id": "whoosh",
        "file": "sfx/whoosh.mp3",
        "trigger": "on-segment-start",
        "volume": 0.3
      }
    ],
    "music": {
      "file": "music/upbeat.mp3",
      "energy": "high",
      "volume": 0.15,
      "loop": true
    }
  },

  "camera": {
    "punchlineZoom": 1.3,
    "focusOnFace": true
  },

  "instructions": "prompt.md"
}
