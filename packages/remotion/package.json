{
  "name": "@lynlens/remotion",
  "version": "0.5.1",
  "private": true,
  "type": "module",
  "description": "Remotion render engine for LynLens packaging-tab export (business-explainer template). Scoped to the packaging tab only — other tabs keep the ffmpeg+libass pipeline.",
  "main": "./src/index.ts",
  "scripts": {
    "studio": "remotion studio",
    "render:poc": "node src/render.mjs --poc",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@remotion/bundler": "4.0.463",
    "@remotion/cli": "4.0.463",
    "@remotion/fonts": "4.0.463",
    "@remotion/layout-utils": "4.0.463",
    "@remotion/media-parser": "4.0.463",
    "@remotion/renderer": "4.0.463",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "remotion": "4.0.463"
  },
  "devDependencies": {
    "@types/react": "19.2.0",
    "@types/react-dom": "19.2.0",
    "typescript": "5.9.3"
  }
}
